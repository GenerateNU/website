{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["src/index.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "sanity": {
      "entry": ["sanity.config.ts", "sanity.cli.ts"],
      "project": ["**/*.ts"]
    }
  },
  "treatTagHintsAsErrors": true,
  "includeEntryExports": true
}
