{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true, // the 87 existing .js/.jsx files keep working
    "checkJs": false, // ...without erroring on day one
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client", "vite-plugin-svgr/client"]
  },
  "include": ["src", "vite.config.ts", "oxlint.config.ts"]
}
